[Unit]
Description=Bcastly Telegram Broadcaster
After=network.target mysql.service

[Service]
Type=simple
User=bcastly
Group=bcastly
WorkingDirectory=/var/www/bcastly
Environment=NODE_ENV=production
EnvironmentFile=/etc/bcastly/bcastly.env
ExecStart=/usr/bin/npm run start -- -p 3000
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
